{
  "name": "@handrail/bug-reporter",
  "version": "0.1.NaN",
  "description": "Browser-safe, server, and headless React bug reporter integrations for Handrail",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:release": "node ./scripts/generate-release.mjs",
    "build": "npm run generate:release && tsup",
    "typecheck": "npm run generate:release && tsc --noEmit -p tsconfig.json",
    "test:contracts": "tsc --noEmit -p tsconfig.contracts.json",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm run test:contracts && npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "esbuild": "^0.25.8",
    "react": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
